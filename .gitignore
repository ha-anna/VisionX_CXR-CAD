# ============================================================
# VisionX CXR-CAD Gitignore
# ============================================================


# ------------------------------------------------------------
# Python
# ------------------------------------------------------------

__pycache__/
*.py[cod]
*$py.class
*.so

# Build / packaging
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Python virtual environments
.venv/
venv/
env/
ENV/
venv.bak/
env.bak/


# ------------------------------------------------------------
# Python tooling / caches
# ------------------------------------------------------------

.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/
.cache/

.coverage
.coverage.*
htmlcov/
coverage.xml

*.log


# ------------------------------------------------------------
# Jupyter / IPython
# ------------------------------------------------------------

.ipynb_checkpoints/
*/.ipynb_checkpoints/

.ipython/
profile_default/


# ------------------------------------------------------------
# Environment variables / secrets
# ------------------------------------------------------------

.env
.env.*
!.env.example

*.pem
*.key

credentials*.json
service-account*.json

.streamlit/secrets.toml


# ------------------------------------------------------------
# macOS
# ------------------------------------------------------------

.DS_Store
.AppleDouble
.LSOverride

Icon?

._*

.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns

.com.apple.timemachine.donotpresent


# ------------------------------------------------------------
# Windows
# ------------------------------------------------------------

Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db

[Dd]esktop.ini

$RECYCLE.BIN/

*.cab
*.msi
*.msix
*.msm
*.msp

*.lnk


# ------------------------------------------------------------
# IDEs / editors
# ------------------------------------------------------------

# VS Code
.vscode/

# JetBrains / PyCharm
.idea/
*.iml

# Vim
*.swp
*.swo
*~

# Sublime Text
*.sublime-workspace


# ------------------------------------------------------------
# Project data
# NEVER commit medical datasets to Git
# ------------------------------------------------------------

data/**
datasets/**

# Keep documentation/placeholders if present
!data/README.md
!data/.gitkeep

!datasets/README.md
!datasets/.gitkeep


# ------------------------------------------------------------
# Medical image / dataset files
# ------------------------------------------------------------

# Keep these ignored when stored in dataset directories.
# The data/** and datasets/** rules above already cover them.

*.dcm


# ------------------------------------------------------------
# Trained models / checkpoints
# ------------------------------------------------------------

models/**
checkpoints/
weights/

!models/README.md
!models/.gitkeep

*.pth
*.pt
*.ckpt
*.onnx
*.h5
*.hdf5


# ------------------------------------------------------------
# ML experiment outputs
# ------------------------------------------------------------

outputs/
output/
results/generated/
artifacts/

runs/
wandb/
mlruns/
lightning_logs/

tensorboard/
tb_logs/


# ------------------------------------------------------------
# Temporary predictions / generated images
# ------------------------------------------------------------

predictions/
gradcam_outputs/
temp/
tmp/

*.tmp


# ------------------------------------------------------------
# NumPy / generated intermediate data
# ------------------------------------------------------------

*.npy
*.npz


# ------------------------------------------------------------
# Local databases / caches
# ------------------------------------------------------------

*.sqlite
*.sqlite3
*.db


# ------------------------------------------------------------
# Docker local overrides
# ------------------------------------------------------------

docker-compose.override.yml


# ------------------------------------------------------------
# OS / miscellaneous temporary files
# ------------------------------------------------------------

*.bak
*.old
*.orig
*.rej

.cache/